    "z": "050ef760976f2d6e",
    "name": "setWaitingGetEmployeeRequest",
    "func": "flow.set(\"waitingGetEmployeeRequest\", msg);\n\nreturn null;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
