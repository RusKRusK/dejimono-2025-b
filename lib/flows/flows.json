    "id": "48f19e1857121e93",
    "type": "function",
    "z": "ed42732c80150553",
    "name": "createLogDataFormat",
    "func": "// --現在時刻取得ロジック--\nconst now = new Date();\n\nconst jstString = now.toLocaleString(\"en-US\", { timeZone: \"Asia/Tokyo\" });\nconst jstDate = new Date(jstString);\n\nconst yyyy = jstDate.getFullYear();\nconst MM = String(jstDate.getMonth() + 1).padStart(2, '0');\nconst dd = String(jstDate.getDate()).padStart(2, '0');\nconst hh = String(jstDate.getHours()).padStart(2, '0');\nconst mm = String(jstDate.getMinutes()).padStart(2, '0');\nconst ss = String(jstDate.getSeconds()).padStart(2, '0');\n\nconst formattedTime = `${yyyy}年${MM}月${dd}日 ${hh}時${mm}分${ss}秒`;\n\nconst waitingRequest = flow.get(\"waitingBorrowingKeyRequest\");\nconst postBody = (waitingRequest && waitingRequest.payload) ? waitingRequest.payload : {};\n\n// --csv記録データ構築--\nconst logData = {\n    timestamp: formattedTime,\n    employee_id: postBody.employee_id || \"unknown\", // 社員ID\n    employee_name: postBody.employee_name || \"unknown\", // 社員名\n    locker_id: postBody.locker_id || \"unknown\", // 該当ロッカー番号\n    status: \"借用\", // ステータス\n};\n\nmsg.payload = logData;\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
