  {
    "id": "e8c4b9e587b6dba5",
    "type": "function",
    "z": "050ef760976f2d6e",
    "name": "matchDetermination",
    "func": "const waitingMsg = flow.get(\"waitingGetEmployeeRequest\");\n\nconst employeeList = msg.payload;\n\nconst targetId = msg.searchId;\n\n// --- 検索処理 ---\nconst matchedData = employeeList.find(row => String(row.employee_id) === String(targetId));\n\n// --- 応答メッセージの作成 ---\nmsg.req = waitingMsg.req;\nmsg.res = waitingMsg.res;\n\nif (matchedData) {\n    msg.payload = matchedData;\n} else {\n    msg.payload = {\n        status: \"Not Found\",\n        message: \"IDが登録されていません\",\n        inputId: targetId\n    };\n    msg.statusCode = 404;\n}\n\n\nflow.set(\"waitingGetEmployeeRequest\", null);\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1160,
    "y": 220,
    "wires": [["3ee65ab17649973f"]]
  },
